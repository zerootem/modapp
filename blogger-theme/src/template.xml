<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateVersion='1.0.0' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale.language' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <!--
    ============================================================
    ModWeeb Theme 1.0 — a Blogger theme for ModWeeb
    https://modweeb.com  ·  https://github.com/zerootem
    Includes ideas from react-theme (MIT, Deo Kumar) — see LICENSE.
    ============================================================
  -->
  <meta content='width=device-width, initial-scale=1, viewport-fit=cover' name='viewport'/>
  <meta content='IE=edge' http-equiv='X-UA-Compatible'/>

  <b:include data='blog' name='all-head-content'/>

  <link href='https://www.blogger.com' rel='dns-prefetch'/>
  <link href='https://blogger.googleusercontent.com' rel='dns-prefetch'/>
  <link href='https://lh3.googleusercontent.com' rel='dns-prefetch'/>
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>

  <meta content='#f9fafb' name='theme-color'/>
  <meta content='ModWeeb Theme' name='generator'/>
  <meta content='max-image-preview:large' name='robots'/>

  <b:if cond='data:view.isSingleItem'>
    <meta content='article' property='og:type'/>
    <meta expr:content='data:post.title.escaped' property='og:title'/>
    <meta expr:content='data:blog.title.escaped' property='og:site_name'/>
    <meta expr:content='data:post.url.canonical' property='og:url'/>
    <b:if cond='data:post.snippets.short'>
      <meta expr:content='data:post.snippets.short.escaped' property='og:description'/>
    </b:if>
    <b:if cond='data:post.featuredImage'>
      <b:if cond='data:post.featuredImage.isResizable'>
        <meta expr:content='resizeImage(data:post.featuredImage, 1200, &quot;16:9&quot;)' property='og:image'/>
      <b:else/>
        <meta expr:content='data:post.featuredImage' property='og:image'/>
      </b:if>
      <meta content='1200' property='og:image:width'/>
      <meta content='630' property='og:image:height'/>
    </b:if>
    <meta expr:content='data:post.title.escaped' property='og:image:alt'/>
    <meta expr:content='data:post.url.canonical' name='twitter:url'/>
    <meta expr:content='data:post.title.escaped' name='twitter:title'/>
    <meta content='summary_large_image' name='twitter:card'/>
    <b:if cond='data:post.snippets.short'>
      <meta expr:content='data:post.snippets.short.escaped' name='twitter:description'/>
    </b:if>
    <b:if cond='data:post.featuredImage'>
      <b:if cond='data:post.featuredImage.isResizable'>
        <meta expr:content='resizeImage(data:post.featuredImage, 1200, &quot;16:9&quot;)' name='twitter:image'/>
      <b:else/>
        <meta expr:content='data:post.featuredImage' name='twitter:image'/>
      </b:if>
    </b:if>
  <b:else/>
    <meta content='website' property='og:type'/>
    <meta expr:content='data:blog.title.escaped' property='og:title'/>
    <meta expr:content='data:blog.title.escaped' property='og:site_name'/>
    <meta expr:content='data:blog.url.canonical' property='og:url'/>
    <b:if cond='data:blog.metaDescription'>
      <meta expr:content='data:blog.metaDescription.escaped' property='og:description'/>
    </b:if>
    <meta expr:content='data:blog.blogspotFaviconUrl' property='og:image'/>
    <meta content='summary' name='twitter:card'/>
    <meta expr:content='data:blog.title.escaped' name='twitter:title'/>
    <b:if cond='data:blog.metaDescription'>
      <meta expr:content='data:blog.metaDescription.escaped' name='twitter:description'/>
    </b:if>
  </b:if>

  <!-- structured data -->
  <script type='application/ld+json'>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "<data:blog.title.jsonEscaped/>",
      "url": "<data:blog.homepageUrl.canonical.jsonEscaped/>",
      "inLanguage": "<data:blog.locale.language.jsonEscaped/>",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "<data:blog.homepageUrl.canonical.jsonEscaped/>search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
  <b:if cond='data:view.isPost'>
    <script type='application/ld+json'>
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "mainEntityOfPage": { "@type": "WebPage", "@id": "<data:post.url.canonical.jsonEscaped/>" },
        "headline": "<data:post.title.jsonEscaped/>",
        <b:if cond='data:post.featuredImage'>"image": ["<b:eval expr='data:post.featuredImage.isResizable ? resizeImage(data:post.featuredImage, 1200, &quot;16:9&quot;) : data:post.featuredImage'/>"],</b:if>
        "datePublished": "<b:eval expr='data:post.date format &quot;yyyy-MM-dd&quot;'/>",
        "dateModified": "<b:eval expr='data:post.date format &quot;yyyy-MM-dd&quot;'/>",
        "author": { "@type": "Person", "name": "<data:post.author.name.jsonEscaped/>" },
        "publisher": { "@type": "Organization", "name": "<data:blog.title.jsonEscaped/>", "logo": { "@type": "ImageObject", "url": "<data:blog.blogspotFaviconUrl.jsonEscaped/>" } },
        "description": "<b:if cond='data:post.snippets.short'><data:post.snippets.short.jsonEscaped/></b:if>"
      }
    </script>
  </b:if>

  <!-- no-flash theme bootstrap -->
  <script>/*<![CDATA[*/
    (function () {
      try {
        var d = document.documentElement, s = window.localStorage;
        var m = s.getItem('mw.mode') || 'auto';
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        d.setAttribute('data-mode', m === 'auto' ? (dark ? 'dark' : 'light') : m);
        d.setAttribute('data-mode-pref', m);
        d.setAttribute('data-accent', s.getItem('mw.accent') || 'blue');
        var l = s.getItem('mw.lang');
        if (l) {
          d.setAttribute('lang', l);
          d.setAttribute('dir', (l === 'ar' || l === 'ur') ? 'rtl' : 'ltr');
        }
      } catch (e) {}
    })();
  /*]]>*/</script>

  <b:skin><![CDATA[{{SKIN}}]]></b:skin>
  <b:template-skin><![CDATA[
    body#layout { background: #f6f7f9; padding: 12px; }
    body#layout .section { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; margin-bottom: 12px; }
    body#layout .section h4 { background: #eff6ff; color: #1d4ed8; margin: 0 0 8px; padding: 8px; border-radius: 10px 10px 0 0; text-align: center; }
    body#layout .widget { border-radius: 8px; }
  ]]></b:template-skin>
</head>

<body>
<a class='skip-link' data-i18n='skip' href='#main-content'>تخطَّ إلى المحتوى</a>
<div aria-hidden='true' class='reading-progress'><span></span></div>

<!-- ===================== Header ===================== -->
<header class='site-header'>
  <div class='container header-inner'>

    <b:section class='header-brand' id='header' maxwidgets='1' showaddelement='false'>
      <b:widget id='Header1' locked='true' title='ModWeeb (Header)' type='Header' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='displayUrl'/>
          <b:widget-setting name='displayHeight'>0</b:widget-setting>
          <b:widget-setting name='sectionWidth'>0</b:widget-setting>
          <b:widget-setting name='useImage'>false</b:widget-setting>
          <b:widget-setting name='shrinkToFit'>false</b:widget-setting>
          <b:widget-setting name='imagePlacement'>REPLACE</b:widget-setting>
          <b:widget-setting name='displayWidth'>0</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <a class='brand' expr:href='data:blog.homepageUrl' expr:title='data:blog.title'>
            <b:if cond='data:sourceUrl'>
              <img class='brand-logo' expr:alt='data:blog.title' expr:src='resizeImage(data:sourceUrl, 96, &quot;1:1&quot;)' width='34' height='34'/>
            <b:else/>
              <svg aria-hidden='true' class='brand-logo' viewBox='0 0 514 514' xmlns='http://www.w3.org/2000/svg'>
    <rect fill='#ffffff' height='514' rx='116' width='514'/>
    <g transform='translate(257 257) scale(0.86) translate(-257 -226)'>
      <path d='M195 167.9c-3.4 1.7-8 7.3-28 33.2l-8.8 11.5 14 18.2 14 18.2 3.8-3.4c6.6-6 14.2-7 21.3-2.8 2.5 1.5 19 22.2 68 85.9 6.5 8.4 13 16 14.5 17.1 6.5 4.5 15.5 5.5 20.2 2.2 2.7-1.9 43-53 43-54.5a301 301 0 0 0-24.2-30.3c-.5.2-5.5 6.4-11.1 13.7-9.5 12.4-13 16.2-14 15L273 247c-58.8-76.2-59.3-76.8-63.1-79a15.7 15.7 0 0 0-15-.1' fill='rgba(225,20,98,.9)'/>
      <path d='M104 180.4c-2 1.3-4.8 4.6-6.3 7.4-5.7 10.6-4.6 20.3 3.7 31C182 322.5 204.4 351 206.1 352c7 3.7 12.7 2.8 18-2.8a948 948 0 0 0 29.2-37c.6-.8-3-6-11.3-16.8L230 280l-4.5 3.2c-8.6 6.1-19.4 4.8-27-3.4-1.7-1.8-19.4-24.3-39.3-50a1327.4 1327.4 0 0 0-39.2-49.2c-4.1-3.5-11-3.6-16-.2' fill='rgba(111,202,220,.9)'/>
      <path d='M312 173.6c-2 1.2-35.7 43.5-42.7 53.4-1 1.5.4 3.8 10.3 16.6l12.4 15.7a87 87 0 0 0 13-15c6.7-8.7 12.8-15.8 13.5-15.8 1.3 0 39 47.6 44.2 56a950 950 0 0 0 35.7 45.4c3 2.4 10.8 2.6 15.2.3 10-5.1 16.2-17.1 13.4-25.6-.6-1.9-9.5-14.3-19.8-27.5L362.5 220a1046 1046 0 0 1-29-38.4c-4.1-6.6-8.5-9.5-14.4-9.5-2.5 0-5.7.8-7.1 1.6' fill='rgba(61,184,143,.9)'/>
      <path d='M106.8 282.6c-24.2 31.2-24.8 32-26.3 36.4a26.2 26.2 0 0 0 4.1 24.5c4.7 6.2 12 8.2 18.3 5a830 830 0 0 0 43.3-54c.6-1.1-21.2-30.7-23.2-31.4a191 191 0 0 0-16.2 19.5m298.8-118c-3 .8-8.8 4.8-12.2 8.4a446.8 446.8 0 0 0-26.1 38c-.3 1.1 4 7.6 11.4 17.3 11 14.7 11.9 15.5 13.3 13.7l14-20a4025 4025 0 0 1 16.2-23.3c8.5-12 7-28.6-2.9-33.3a26 26 0 0 0-13.7-.8' fill='rgba(233,169,32,.9)'/>
    </g>
  </svg>
            </b:if>
            <span class='brand-text'>
              <span class='brand-title'><data:blog.title/></span>
              <b:if cond='data:blog.description'>
                <span class='brand-desc'><data:blog.description/></span>
              </b:if>
            </span>
          </a>
        </b:includable>
      </b:widget>
    </b:section>

    <nav aria-label='Main' class='main-nav' id='main-nav'>
      <ul>
        <li><a expr:href='data:blog.homepageUrl'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M3 10.5 12 3l9 7.5'/><path d='M5 9.5V21h14V9.5'/></svg><span data-i18n='home'>الرئيسية</span></a></li>
      </ul>
      <b:section class='header-nav' id='nav' maxwidgets='1' showaddelement='false'>
        <b:widget id='PageList1' locked='false' title='Pages' type='PageList' version='2' visible='true'>
          <b:includable id='main'>
            <b:if cond='data:links'>
              <ul>
                <b:loop values='data:links' var='link'>
                  <li><b:class cond='data:link.isCurrentPage' name='selected'/><a expr:href='data:link.href'><data:link.title/></a></li>
                </b:loop>
              </ul>
            </b:if>
          </b:includable>
        </b:widget>
      </b:section>
    </nav>

    <div class='header-actions'>
      <button aria-controls='site-search' aria-expanded='false' class='icon-btn' data-i18n-aria='search' data-toggle='search' type='button'>
        <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/></svg>
      </button>

      <div class='popover-anchor'>
        <button aria-controls='theme-pop' aria-expanded='false' class='icon-btn' data-i18n-aria='theme' data-toggle='theme' type='button'>
          <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M12 3a9 9 0 1 0 0 18c1.7 0 2-1 1.4-2-.5-1 .2-2 1.6-2H17a4 4 0 0 0 4-4c0-5.5-4-10-9-10Z'/><circle cx='7.5' cy='11.5' fill='currentColor' r='1' stroke='none'/><circle cx='10' cy='7.5' fill='currentColor' r='1' stroke='none'/><circle cx='14.5' cy='7.5' fill='currentColor' r='1' stroke='none'/></svg>
        </button>
        <div class='popover' id='theme-pop' role='dialog'>
          <p class='popover-title' data-i18n='colors'>لون السمة</p>
          <div class='swatch-grid'>
            <button aria-pressed='false' class='swatch' data-accent-option='blue' style='--swatch:#3b82f6' title='Blue' type='button'></button>
            <button aria-pressed='false' class='swatch' data-accent-option='violet' style='--swatch:#7c3aed' title='Violet' type='button'></button>
            <button aria-pressed='false' class='swatch' data-accent-option='teal' style='--swatch:#0f766e' title='Teal' type='button'></button>
            <button aria-pressed='false' class='swatch' data-accent-option='emerald' style='--swatch:#15803d' title='Emerald' type='button'></button>
            <button aria-pressed='false' class='swatch' data-accent-option='rose' style='--swatch:#be123c' title='Rose' type='button'></button>
            <button aria-pressed='false' class='swatch' data-accent-option='amber' style='--swatch:#b45309' title='Amber' type='button'></button>
          </div>
          <div class='seg'>
            <button aria-pressed='false' data-mode-option='auto' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='12' cy='12' r='8'/><path d='M12 4v16'/></svg><span data-i18n='auto'>تلقائي</span></button>
            <button aria-pressed='false' data-mode-option='light' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/></svg><span data-i18n='light'>فاتح</span></button>
            <button aria-pressed='false' data-mode-option='soft' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M4 17a8 8 0 0 1 16 0'/><path d='M4 20h16'/></svg><span data-i18n='soft'>ناعم</span></button>
            <button aria-pressed='false' data-mode-option='dark' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z'/></svg><span data-i18n='dark'>داكن</span></button>
          </div>
        </div>
      </div>

      <div class='popover-anchor'>
        <button aria-controls='lang-pop' aria-expanded='false' class='icon-btn' data-i18n-aria='language' data-toggle='lang' type='button'>
          <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z'/></svg>
        </button>
        <div class='popover' id='lang-pop' role='dialog'>
          <p class='popover-title' data-i18n='language'>اللغة</p>
          <ul class='menu-list'>
            <li><button aria-pressed='false' data-lang-option='ar' type='button'>العربية</button></li>
            <li><button aria-pressed='false' data-lang-option='en' type='button'>English</button></li>
            <li><button aria-pressed='false' data-lang-option='fr' type='button'>Français</button></li>
            <li><button aria-pressed='false' data-lang-option='es' type='button'>Español</button></li>
            <li><button aria-pressed='false' data-lang-option='tr' type='button'>Türkçe</button></li>
            <li><button aria-pressed='false' data-lang-option='ur' type='button'>اردو</button></li>
          </ul>
        </div>
      </div>

      <button aria-controls='main-nav' aria-expanded='false' aria-label='Menu' class='icon-btn menu-btn' data-toggle='menu' type='button'>
        <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M4 7h16M4 12h16M4 17h16'/></svg>
      </button>
    </div>
  </div>

  <div class='site-search' id='site-search'>
    <form class='search-form' expr:action='data:blog.searchUrl' method='get' role='search'>
      <input aria-label='Search' data-i18n-placeholder='searchPlaceholder' name='q' placeholder='ابحث في المدونة…' type='search'/>
      <button type='submit'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/></svg><span data-i18n='searchGo'>بحث</span></button>
    </form>
  </div>
</header>

<!-- ===================== Main ===================== -->
<main class='container page-grid' id='main-content'>
  <div class='page-main'>
  <b:section class='main-section' id='main' showaddelement='false'>
    <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
      <b:widget-settings>
        <b:widget-setting name='showDateHeader'>false</b:widget-setting>
        <b:widget-setting name='showShareButtons'>false</b:widget-setting>
        <b:widget-setting name='showCommentLink'>true</b:widget-setting>
        <b:widget-setting name='showAuthor'>true</b:widget-setting>
        <b:widget-setting name='showLabels'>true</b:widget-setting>
        <b:widget-setting name='showLocation'>false</b:widget-setting>
        <b:widget-setting name='showTimestamp'>true</b:widget-setting>
        <b:widget-setting name='showBacklinks'>false</b:widget-setting>
        <b:widget-setting name='showInlineAds'>false</b:widget-setting>
        <b:widget-setting name='showReactions'>false</b:widget-setting>
      </b:widget-settings>

      <b:includable id='main'>
        <b:if cond='data:view.isError'>
          <section class='error-page'>
            <p class='error-code'>404</p>
            <h1 data-i18n='errorTitle'>الصفحة غير موجودة</h1>
            <p data-i18n='errorText'>ربما تغيّر الرابط أو حُذف المحتوى. جرّب البحث أو العودة للرئيسية.</p>
            <p><a class='button' expr:href='data:blog.homepageUrl' data-i18n='backHome' style='display:inline-flex;padding:.55rem 1.1rem;border-radius:999px;background:var(--mw-accent);color:var(--mw-on-accent);font-weight:600'>العودة للرئيسية</a></p>
          </section>
        <b:elseif cond='data:view.isSingleItem'/>
          <b:loop values='data:posts' var='post'>
            <b:include data='post' name='postPage'/>
          </b:loop>
        <b:else/>
          <b:include name='listPage'/>
        </b:if>
      </b:includable>

      <!-- listing -->
      <b:includable id='listPage'>
        <div class='page-head'>
          <b:if cond='data:view.isHomepage'>
            <h1><data:blog.title/></h1>
            <b:if cond='data:blog.description'>
              <p><data:blog.description/></p>
            </b:if>
          <b:elseif cond='data:view.isLabelSearch'/>
            <p class='badge soft'># <data:view.search.label/></p>
            <h1><data:view.search.label/></h1>
            <p data-i18n='filter'>تصفية</p>
          <b:elseif cond='data:view.search.query'/>
            <h1><data:view.search.query/></h1>
            <p data-i18n='search'>بحث</p>
          <b:elseif cond='data:view.isArchive'/>
            <h1><data:blog.pageName/></h1>
          <b:else/>
            <h1><data:blog.pageName/></h1>
          </b:if>
        </div>

        <b:if cond='data:posts.size == 0'>
          <div class='empty-state'>
            <p data-i18n='errorText'>لا توجد نتائج مطابقة.</p>
            <a class='chip' expr:href='data:blog.homepageUrl' data-i18n='backHome'>العودة للرئيسية</a>
          </div>
        <b:else/>
          <div class='section'>
            <b:if cond='data:view.isHomepage'>
              <b:loop index='i' values='data:posts' var='post'>
                <b:if cond='data:i == 0'>
                  <b:include data='post' name='featuredPost'/>
                </b:if>
              </b:loop>
            </b:if>

            <div class='section-head'>
              <div>
                <h2 data-i18n='latest'>أحدث المقالات</h2>
                <p><data:blog.title/></p>
              </div>
            </div>

            <div class='cards'>
              <b:loop index='i' values='data:posts' var='post'>
                <b:if cond='!(data:view.isHomepage and data:i == 0)'>
                  <b:include data='post' name='postCard'/>
                </b:if>
              </b:loop>
            </div>

            <div class='pagination'>
              <b:if cond='data:newerPageUrl'>
                <a expr:href='data:newerPageUrl' rel='prev'><svg aria-hidden='true' class='icon' style='transform:rotate(180deg)' viewBox='0 0 24 24'><path d='m9 6 6 6-6 6'/></svg><span data-i18n='newer'>أحدث</span></a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a expr:href='data:olderPageUrl' rel='next'><span data-i18n='older'>أقدم</span><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='m9 6 6 6-6 6'/></svg></a>
              </b:if>
            </div>
          </div>
        </b:if>
      </b:includable>

      <!-- featured -->
      <b:includable id='featuredPost' var='post'>
        <article class='featured'>
          <b:if cond='data:post.featuredImage'>
            <a class='featured-media' expr:href='data:post.url' tabindex='-1' aria-hidden='true'>
              <b:if cond='data:post.featuredImage.isResizable'>
                <img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 960, &quot;16:9&quot;)' loading='eager' width='960' height='540'/>
              <b:else/>
                <img expr:alt='data:post.title' expr:src='data:post.featuredImage' loading='eager'/>
              </b:if>
            </a>
          </b:if>
          <div class='featured-body'>
            <span class='badge featured-badge' data-i18n='featured'>مقال مميز</span>
            <h2><a expr:href='data:post.url'><data:post.title/></a></h2>
            <b:if cond='data:post.snippets.short'>
              <p class='excerpt'><data:post.snippets.short/></p>
            </b:if>
            <div class='article-meta'>
              <span class='byline'>
                <b:if cond='data:post.author.authorPhoto.image'>
                  <img expr:alt='data:post.author.name' expr:src='resizeImage(data:post.author.authorPhoto.image, 48, &quot;1:1&quot;)' loading='lazy' width='30' height='30'/>
                </b:if>
                <span class='name'><data:post.author.name/></span>
              </span>
              <span class='meta-line'>
                <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><rect height='16' rx='2' width='18' x='3' y='4'/><path d='M3 9h18M8 2v4M16 2v4'/></svg>
                <time expr:datetime='data:post.date.iso8601'><b:eval expr='data:post.date format &quot;d MMMM yyyy&quot;'/></time>
              </span>
            </div>
          </div>
        </article>
      </b:includable>

      <!-- card -->
      <b:includable id='postCard' var='post'>
        <article class='card'>
          <b:if cond='data:post.featuredImage'>
            <a class='card-media' expr:href='data:post.url' tabindex='-1' aria-hidden='true'>
              <b:if cond='data:post.featuredImage.isResizable'>
                <img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 640, &quot;16:9&quot;)' loading='lazy' width='640' height='360'/>
              <b:else/>
                <img expr:alt='data:post.title' expr:src='data:post.featuredImage' loading='lazy'/>
              </b:if>
            </a>
          </b:if>
          <div class='card-body'>
            <b:if cond='data:post.labels'>
              <div class='chips'>
                <b:loop index='i' values='data:post.labels' var='label'>
                  <b:if cond='data:i == 0'>
                    <a class='chip' expr:href='data:label.url'><span class='hash'>#</span><data:label.name/></a>
                  </b:if>
                </b:loop>
              </div>
            </b:if>
            <h3 class='card-title'><a expr:href='data:post.url'><data:post.title/></a></h3>
            <b:if cond='data:post.snippets.short'>
              <p class='card-excerpt'><data:post.snippets.short/></p>
            </b:if>
            <div class='card-foot'>
              <span class='byline'>
                <b:if cond='data:post.author.authorPhoto.image'>
                  <img expr:alt='data:post.author.name' expr:src='resizeImage(data:post.author.authorPhoto.image, 48, &quot;1:1&quot;)' loading='lazy' width='22' height='22'/>
                </b:if>
                <span class='name'><data:post.author.name/></span>
              </span>
              <span class='meta-line'>
                <time expr:datetime='data:post.date.iso8601'><b:eval expr='data:post.date format &quot;d MMM yyyy&quot;'/></time>
              </span>
            </div>
          </div>
        </article>
      </b:includable>

      <!-- single post / page -->
      <b:includable id='postPage' var='post'>
        <div class='article-wrap'>
          <nav aria-label='Breadcrumb' class='breadcrumb'>
            <a expr:href='data:blog.homepageUrl'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M3 10.5 12 3l9 7.5'/><path d='M5 9.5V21h14V9.5'/></svg><span data-i18n='home'>الرئيسية</span></a>
            <b:loop index='i' values='data:post.labels' var='label'>
              <b:if cond='data:i == 0'>
                <span class='sep'>›</span>
                <a expr:href='data:label.url'><data:label.name/></a>
              </b:if>
            </b:loop>
            <span class='sep'>›</span>
            <span aria-current='page'><data:post.title/></span>
          </nav>

          <header class='article-header'>
            <h1><data:post.title/></h1>
            <div class='article-meta'>
              <span class='byline'>
                <b:if cond='data:post.author.authorPhoto.image'>
                  <img expr:alt='data:post.author.name' expr:src='resizeImage(data:post.author.authorPhoto.image, 64, &quot;1:1&quot;)' width='30' height='30'/>
                </b:if>
                <b:if cond='data:post.author.profileUrl'>
                  <a class='name' expr:href='data:post.author.profileUrl'><data:post.author.name/></a>
                <b:else/>
                  <span class='name'><data:post.author.name/></span>
                </b:if>
              </span>
              <span class='meta-line'>
                <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><rect height='16' rx='2' width='18' x='3' y='4'/><path d='M3 9h18M8 2v4M16 2v4'/></svg>
                <time expr:datetime='data:post.date.iso8601'><b:eval expr='data:post.date format &quot;d MMMM yyyy&quot;'/></time>
              </span>
              <span class='meta-line'>
                <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>
                <span data-reading-time='true'>1</span>
              </span>
              <b:if cond='data:post.allowComments'>
                <a class='meta-line' expr:href='data:post.url + &quot;#comments&quot;'>
                  <svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z'/></svg>
                  <span><data:post.numberOfComments/></span>
                </a>
              </b:if>
            </div>
            <b:if cond='data:post.labels'>
              <div class='article-labels chips'>
                <b:loop values='data:post.labels' var='label'>
                  <a class='chip' expr:href='data:label.url'><span class='hash'>#</span><data:label.name/></a>
                </b:loop>
              </div>
            </b:if>
          </header>

          <div class='article-main'>
              <div class='prose' id='post-body'><data:post.body/></div>

              <footer class='article-footer'>
                <b:if cond='data:view.isPost'>
                  <div class='share-bar'>
                    <span class='label' data-i18n='share'>شارك المقال</span>
                    <button aria-label='WhatsApp' class='share-btn' data-share='whatsapp' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M20 11.8a8 8 0 0 1-11.9 7L4 20l1.3-3.9A8 8 0 1 1 20 11.8Z'/><path d='M9 9c0 3 2 5 5 5.5'/></svg></button>
                    <button aria-label='X' class='share-btn' data-share='x' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M4 4l16 16M20 4 4 20'/></svg></button>
                    <button aria-label='Facebook' class='share-btn' data-share='facebook' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h3Z'/></svg></button>
                    <button aria-label='Telegram' class='share-btn' data-share='telegram' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='m21 4-9 16-2.5-6.5L3 11Z'/><path d='m9.5 13.5 4-3'/></svg></button>
                    <button aria-label='LinkedIn' class='share-btn' data-share='linkedin' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><rect height='12' width='4' x='3' y='9'/><circle cx='5' cy='5' r='2'/><path d='M11 21v-7a3 3 0 0 1 6 0v7M11 9v12'/></svg></button>
                    <button class='share-btn' data-share='copy' data-i18n-aria='copyLink' type='button'><svg aria-hidden='true' class='icon' viewBox='0 0 24 24'><path d='M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1'/><path d='M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1'/></svg></button>
                  </div>

                  <b:loop index='i' values='data:post.labels' var='label'>
                    <b:if cond='data:i == 0'>
                      <div class='related' expr:data-blog='data:blog.homepageUrl' expr:data-label='data:label.name' data-limit='3' data-related='true' expr:data-url='data:post.url' hidden='hidden'>
                        <div class='section-head'><h2 data-i18n='related'>اقرأ أيضًا</h2></div>
                        <div class='cards cols-3' data-related-grid='true'></div>
                      </div>
                    </b:if>
                  </b:loop>
                </b:if>

                <b:if cond='data:view.isPost and data:post.allowComments'>
                  <b:include data='post' name='comments'/>
                </b:if>
              </footer>
          </div>
        </div>
      </b:includable>

      <!-- comments -->
      <b:includable id='comments' var='post'>
        <section class='comments-wrap' id='comments'>
          <h2>التعليقات <span class='comment-count'>(<data:post.numberOfComments/>)</span></h2>
              
          <b:if cond='data:post.comments'>
            <ul class='comment-thread'>
              <b:loop values='data:post.comments' var='comment'>
                <li class='comment' expr:id='data:comment.anchorName'>
                  <div class='comment-header'>
                    <cite><data:comment.author/></cite>
                    <b:if cond='data:comment.timestampISO8601'>
                      <a expr:href='data:comment.url'><time expr:datetime='data:comment.timestampISO8601'><data:comment.timestamp/></time></a>
                    </b:if>
                  </div>
                  <div class='comment-content'><data:comment.body/></div>
                  <b:if cond='data:comment.deleteUrl'>
                    <div class='comment-actions'><a expr:href='data:comment.deleteUrl' rel='nofollow'>حذف</a></div>
                  </b:if>
                </li>
              </b:loop>
            </ul>
          <b:else/>
            <p class='comment-count' data-i18n='noComments'>لا توجد تعليقات بعد</p>
          </b:if>

          <b:if cond='data:post.allowNewComments'>
            <b:include data='post' name='commentForm'/>
          <b:else/>
            <p class='comment-count'><data:post.noNewCommentsText/></p>
          </b:if>
        </section>
      </b:includable>

      <b:includable id='commentForm' var='post'>
        <div class='comment-form'>
          <a name='comment-form'/>
          <h3 data-i18n='comments'>التعليقات</h3>
          <a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src' style='display:none'>comment form</a>
          <iframe allowtransparency='true' class='blogger-iframe-colorize blogger-comment-from-post' expr:src='data:post.commentFormIframeSrc' frameborder='0' height='410' id='comment-editor' name='comment-editor' width='100%'></iframe>
          <script src='https://www.blogger.com/static/v1/jsbin/1769625011-comment_from_post_iframe.js' type='text/javascript'></script>
          <script type='text/javascript'>BLOG_CMT_createIframe('<data:post.appRpcRelayPath/>');</script>
        </div>
      </b:includable>
    </b:widget>
  </b:section>
  </div>

  <aside class='article-side'>
    <b:section id='sidebar' showaddelement='true'>
      <b:widget id='PopularPosts1' locked='false' title='الأكثر قراءة' type='PopularPosts' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='numItemsToShow'>5</b:widget-setting>
          <b:widget-setting name='showThumbnails'>true</b:widget-setting>
          <b:widget-setting name='showSnippets'>false</b:widget-setting>
          <b:widget-setting name='timeRange'>ALL_TIME</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:if cond='data:posts'>
            <div class='widget-content'>
              <h2 class='widget-title'><data:title/></h2>
              <ul>
                <b:loop values='data:posts' var='post'>
                  <li>
                    <a expr:href='data:post.href'>
                      <b:if cond='data:post.thumbnail'>
                        <img class='item-thumbnail' expr:alt='data:post.title' expr:src='data:post.thumbnail' loading='lazy'/>
                      </b:if>
                      <span><data:post.title/></span>
                    </a>
                  </li>
                </b:loop>
              </ul>
            </div>
          </b:if>
        </b:includable>
      </b:widget>
    </b:section>
  </aside>
</main>

<!-- ===================== Tags ===================== -->
<div class='container'>
  <b:section class='footer-tags' id='footer-tags' maxwidgets='1' showaddelement='true'>
    <b:widget id='Label2' locked='false' title='تصفّح حسب الوسم' type='Label' version='2' visible='true'>
      <b:includable id='main'>
        <b:if cond='data:labels'>
          <section class='section'>
            <div class='section-head'>
              <div>
                <h2><data:title/></h2>
                <p data-i18n='tags'>الوسوم</p>
              </div>
            </div>
            <div class='tag-cloud'>
              <b:loop values='data:labels' var='label'>
                <a expr:href='data:label.url'><data:label.name/><b:if cond='data:label.count'><span class='count'>(<data:label.count/>)</span></b:if></a>
              </b:loop>
            </div>
          </section>
        </b:if>
      </b:includable>
    </b:widget>
  </b:section>
</div>

<!-- ===================== Footer ===================== -->
