          <span class='brand-text'><span class='brand-title'><data:blog.title/></span></span>
        </a>
        <p data-i18n='siteDesc'>مقالات وأدوات في صناعة المحتوى والتقنية.</p>
      </div>

      <div class='footer-col'>
        <h3 data-i18n='pages'>الصفحات</h3>
        <ul>
          <li><a expr:href='data:blog.homepageUrl' data-i18n='home'>الرئيسية</a></li>
        </ul>
        <b:section class='footer-pages' id='footer-nav' maxwidgets='1' showaddelement='false'>
          <b:widget id='PageList2' locked='false' title='Pages' type='PageList' version='2' visible='true'>
            <b:includable id='main'>
              <b:if cond='data:links'>
                <ul>
                  <b:loop values='data:links' var='link'>
                    <li><a expr:href='data:link.href'><data:link.title/></a></li>
